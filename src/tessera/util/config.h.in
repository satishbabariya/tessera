// Version information
#cmakedefine TESSERA_VERSION "@TESSERA_VERSION@"

// Feature detection
#cmakedefine01 TESSERA_HAVE_READDIR64
#cmakedefine01 TESSERA_HAVE_POSIX_FALLOCATE
#cmakedefine01 TESSERA_USE_SYSTEM_OPENSSL_PATHS
#cmakedefine01 TESSERA_HAVE_OPENSSL
#cmakedefine01 TESSERA_HAVE_SECURE_TRANSPORT
#cmakedefine01 TESSERA_HAVE_PTHREAD_GETNAME
#cmakedefine01 TESSERA_HAVE_PTHREAD_SETNAME
#cmakedefine01 TESSERA_HAVE_BACKTRACE
#cmakedefine01 TESSERA_INCLUDE_CERTS
#define TESSERA_MAX_BPNODE_SIZE @TESSERA_MAX_BPNODE_SIZE@
#define TESSERA_BACKTRACE_HEADER <@Backtrace_HEADER@>
#cmakedefine01 TESSERA_ENABLE_ASSERTIONS
#cmakedefine01 TESSERA_ENABLE_ALLOC_SET_ZERO
#cmakedefine01 TESSERA_ENABLE_ENCRYPTION
#cmakedefine01 TESSERA_ENABLE_MEMDEBUG
#cmakedefine01 TESSERA_ENABLE_GEOSPATIAL
#cmakedefine01 TESSERA_VALGRIND
#cmakedefine01 TESSERA_ASAN
#cmakedefine01 TESSERA_TSAN
